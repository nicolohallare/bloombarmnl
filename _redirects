# Preserve SEO from old WordPress URLs
# Format: from-path to-path status-code
# 301 = permanent redirect (best for SEO)

# ── Booking API (Netlify functions) — must stay above the catch-all ──
/api/*            /.netlify/functions/:splat                     200
# Don't serve the function source as static files
/netlify/*        /                                              404!
/supabase/*       /                                              404!

# ── New on-site booking page ──
/book             /book.html                                     200

# Old WordPress service/booking pages → on-site. They used to go to Acuity,
# which handed their search value to Acuity's domain. Service pages land on
# the homepage (indexed); /book itself is noindex, so only booking URLs go there.
/services         /#book                                         301!
/services/*       /#book                                         301!
/microblading     /#book                                         301!
/powder-brows     /#book                                         301!
/combo-brows      /#book                                         301!
/rates            /#book                                         301!
/pricing          /#book                                         301!
/booking          /book                                          301!
/appointment      /book                                          301!

# Info pages → anchors on new single-page site
/about            /#about                                        301!
/about-us         /#about                                        301!
/about-izza       /#about                                        301!
/contact          /#faq                                          301!
/contact-us       /#faq                                          301!
/faq              /#faq                                          301!
/faqs             /#faq                                          301!
/gallery          /#work                                         301!
/portfolio        /#work                                         301!
/work             /#work                                         301!
/before-after     /#work                                         301!
/reviews          /#work                                         301!
/testimonials     /#work                                         301!

# Block WordPress admin/system paths (return 410 gone)
/wp-admin         /                                              410
/wp-admin/*       /                                              410
/wp-login.php     /                                              410
/wp-content/*     /                                              404
/wp-includes/*    /                                              404
/xmlrpc.php       /                                              410
/feed             /                                              301
/feed/*           /                                              301
/?feed=*          /                                              301

# Catch-all: any other unknown URL → homepage (soft landing)
/*                /                                              301
