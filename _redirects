# Preserve SEO from old WordPress URLs
# Format: from-path to-path status-code
# 301 = permanent redirect (best for SEO)

# ── Booking API (Netlify functions) — must stay above the catch-all ──
/api/*            /.netlify/functions/:splat                     200
# Don't serve the function source as static files
/netlify/*        /                                              404!
/supabase/*       /                                              404!

# ── New on-site booking page ──
/book             /book.html                                     200

# ── Free brow check (send a photo, Izza messages you) ──
/consult          /consult.html                                  200
/brow-check       /consult                                       301!
/free-consult     /consult                                       301!

# ── Treatment pages (pretty URLs) ──
/microblading        /microblading.html                         200
/powder-brows        /powder-brows.html                         200
/combo-brows         /combo-brows.html                          200
/combination-brows   /combo-brows                               301!

# ── Short links for bios and profiles (tagged so Analytics knows the source) ──
/ig               /book?utm_source=instagram&utm_medium=social&utm_campaign=bio   301!
/fb               /book?utm_source=facebook&utm_medium=social&utm_campaign=page   301!
/gbp              /book?utm_source=google&utm_medium=organic&utm_campaign=gbp     301!

# Old WordPress service/booking pages → on-site. They used to go to Acuity,
# which handed their search value to Acuity's domain. Service pages land on
# the homepage (indexed); /book itself is noindex, so only booking URLs go there.
# /microblading, /powder-brows and /combo-brows are real pages now (see above).
/services         /#book                                         301!
/services/*       /#book                                         301!
/rates            /#book                                         301!
/pricing          /#book                                         301!
/booking          /book                                          301!
/appointment      /book                                          301!

# Info pages → anchors on new single-page site
/about            /#about                                        301!
/about-us         /#about                                        301!
/about-izza       /#about                                        301!
/contact          /#faq                                          301!
/contact-us       /#faq                                          301!
/faq              /#faq                                          301!
/faqs             /#faq                                          301!
/gallery          /#work                                         301!
/portfolio        /#work                                         301!
/work             /#work                                         301!
/before-after     /#work                                         301!
/reviews          /#work                                         301!
/testimonials     /#work                                         301!

# Block WordPress admin/system paths (return 410 gone)
/wp-admin         /                                              410
/wp-admin/*       /                                              410
/wp-login.php     /                                              410
/wp-content/*     /                                              404
/wp-includes/*    /                                              404
/xmlrpc.php       /                                              410
/feed             /                                              301
/feed/*           /                                              301
/?feed=*          /                                              301

# Catch-all: any other unknown URL → homepage (soft landing)
/*                /                                              301
